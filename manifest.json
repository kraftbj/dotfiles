    },
    {
      "source": "dotfiles/.claude/skills/wp-project-triage",
      "target": ".agents/skills/wp-project-triage",
      "description": "WordPress project triage skill for Codex/agent skill loader"
    },
    {
      "source": "dotfiles/.claude/skills/wp-wpcli-and-ops",
