    },
    {
      "source": "dotfiles/.claude/skills/wp-interactivity-api",
      "target": ".claude/skills/wp-interactivity-api",
      "description": "WordPress Interactivity API skill for Claude"
    },
    {
      "source": "dotfiles/.claude/skills/wp-interactivity-api",
      "target": ".agents/skills/wp-interactivity-api",
      "description": "WordPress Interactivity API skill for Codex/agent skill loader"
    },
    {
      "source": "dotfiles/.claude/skills/wp-performance",
