{
  "version": 1,
  "description": "Dotfiles manifest - defines symlinks from dotfiles/ to home directory",
  "entries": [
    {
      "source": "dotfiles/.claude/settings.json",
      "target": ".claude/settings.json",
      "description": "Claude Code settings with hooks, status line, and MCP servers"
    },
    {
      "source": "dotfiles/.claude/CLAUDE.md",
      "target": ".claude/CLAUDE.md",
      "description": "Global Claude instructions"
    },
    {
      "source": "dotfiles/.gitconfig",
      "target": ".gitconfig",
      "description": "Git configuration with signing, LFS, and sync-all alias"
    },
    {
      "source": "dotfiles/.config/git/ignore",
      "target": ".config/git/ignore",
      "description": "Global gitignore patterns (XDG standard location)"
    },
    {
      "source": "dotfiles/.zshrc",
      "target": ".zshrc",
      "description": "Zsh configuration with oh-my-zsh, plugins, and shell functions"
    },
    {
      "source": "dotfiles/.zprofile",
      "target": ".zprofile",
      "description": "Zsh login shell config with Kiro CLI, Homebrew, and PATH setup"
    },
    {
      "source": "dotfiles/.config/zed/settings.json",
      "target": ".config/zed/settings.json",
      "description": "Zed editor settings"
    },
    {
      "source": "dotfiles/.claude/style-guide.md",
      "target": ".claude/style-guide.md",
      "description": "Personal voice style guide"
    },
    {
      "source": "dotfiles/.gitconfig-a8c",
      "target": ".gitconfig-a8c",
      "description": "Special config for a8c GHE repos"
    }
  ],
  "exclude": {
    "description": "Patterns that will BLOCK addition to manifest - protects sensitive files",
    "patterns": [
      "*.pem",
      "*.key",
      "*_rsa",
      "*_ed25519",
      "*_ecdsa",
      "*_dsa",
      "*.p12",
      "*.pfx",
      ".env",
      ".env.*",
      "credentials*",
      "*secret*",
      "*.secret",
      ".ssh/*",
      ".gnupg/*",
      ".aws/credentials",
      ".netrc",
      "*.keystore",
      "*.jks",
      "id_*",
      "*token*",
      "*_history",
      ".Trash",
      ".cache",
      ".local",
      ".npm",
      ".cargo",
      ".rustup",
      ".bun",
      ".nvm",
      ".gem",
      ".composer",
      ".docker",
      ".cups",
      ".dropbox",
      ".DS_Store",
      ".lesshst",
      ".viminfo",
      ".zsh_history",
      ".zsh_sessions",
      ".zcompdump*",
      ".python_history",
      ".Rhistory",
      ".RData",
      "*.zwc",
      ".mcp-auth",
      ".npmrc",
      ".yarnrc",
      ".config/gh/hosts.yml",
      ".config/github-copilot/*",
      ".config/gh-copilot/*",
      ".config/configstore/*"
    ]
  }
}
