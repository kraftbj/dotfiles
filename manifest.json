    {
      "source": "dotfiles/.claude/commands/daily-digest.md",
      "target": ".claude/commands/daily-digest.md",
      "description": "/daily-digest slash command — invokes the daily-digest-post skill"
    }
  ],
  "exclude": {
    "description": "Patterns that will BLOCK addition to manifest - protects sensitive files",
    "patterns": [
      "*.pem",
      "*.key",
      "*_rsa",
      "*_ed25519",
      "*_ecdsa",
      "*_dsa",
      "*.p12",
      "*.pfx",
      ".env",
      ".env.*",
      "credentials*",
      "*secret*",
      "*.secret",
      ".ssh/*",
      ".gnupg/*",
      ".aws/credentials",
      ".netrc",
      "*.keystore",
      "*.jks",
      "id_*",
      "*token*",
      "*_history",
      ".Trash",
      ".cache",
      ".local",
      ".npm",
      ".cargo",
      ".rustup",
      ".bun",
      ".nvm",
      ".gem",
      ".composer",
      ".docker",
      ".cups",
      ".dropbox",
      ".DS_Store",
      ".lesshst",
      ".viminfo",
      ".zsh_history",
      ".zsh_sessions",
      ".zcompdump*",
      ".python_history",
      ".Rhistory",
      ".RData",
      "*.zwc",
      ".mcp-auth",
      "auth.json",
      "history.jsonl",
      "session_index.jsonl",
      "installation_id",
      ".codex-global-state.json*",
      "*.sqlite*",
      ".npmrc",
      ".yarnrc",
      ".config/gh/hosts.yml",
      ".config/github-copilot/*",
      ".config/gh-copilot/*",
      ".config/configstore/*"
    ]
  }
}
