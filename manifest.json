{
  "version": 1,
  "description": "Dotfiles manifest - defines symlinks from dotfiles/ to home directory",
  "entries": [
    {
      "source": "dotfiles/.claude/settings.json",
      "target": ".claude/settings.json",
      "description": "Claude Code settings with hooks, status line, and MCP servers"
    },
    {
      "source": "dotfiles/.claude/CLAUDE.md",
      "target": ".claude/CLAUDE.md",
      "description": "Global Claude instructions"
    },
    {
      "source": "dotfiles/.codex/AGENTS.md",
      "target": ".codex/AGENTS.md",
      "description": "Global Codex instructions"
    },
    {
      "source": "dotfiles/.gitconfig",
      "target": ".gitconfig",
      "description": "Git configuration with signing, LFS, and sync-all alias"
    },
    {
      "source": "dotfiles/.config/git/ignore",
      "target": ".config/git/ignore",
      "description": "Global gitignore patterns (XDG standard location)"
    },
    {
      "source": "dotfiles/.zshrc",
      "target": ".zshrc",
      "description": "Zsh configuration with oh-my-zsh, plugins, and shell functions"
    },
    {
      "source": "dotfiles/.zprofile",
      "target": ".zprofile",
      "description": "Zsh login shell config with Kiro CLI, Homebrew, and PATH setup"
    },
    {
      "source": "dotfiles/.config/zed/settings.json",
      "target": ".config/zed/settings.json",
      "description": "Zed editor settings"
    },
    {
      "source": "dotfiles/.claude/style-guide.md",
      "target": ".claude/style-guide.md",
      "description": "Personal voice style guide"
    },
    {
      "source": "dotfiles/.gitconfig-a8c",
      "target": ".gitconfig-a8c",
      "description": "Special config for a8c GHE repos"
    },
    {
      "source": "dotfiles/.claude/plugins/claude-hud/config.json",
      "target": ".claude/plugins/claude-hud/config.json",
      "description": "Claude HUD statusline display settings"
    },
    {
      "source": "dotfiles/.claude/skills/daily-digest-post/SKILL.md",
      "target": ".claude/skills/daily-digest-post/SKILL.md",
      "description": "Captain's Log skill — publishes daily summary to kraftcaptainslog, optional fossep2 draft"
    },
    {
      "source": "dotfiles/.claude/skills/daily-digest-post/SKILL.md",
      "target": ".agents/skills/daily-digest-post/SKILL.md",
      "description": "Captain's Log skill for Codex/agent skill loader"
    },
    {
      "source": "dotfiles/.claude/skills/wordpress-router",
      "target": ".claude/skills/wordpress-router",
      "description": "WordPress router skill for Claude"
    },
    {
      "source": "dotfiles/.claude/skills/wordpress-router",
      "target": ".agents/skills/wordpress-router",
      "description": "WordPress router skill for Codex/agent skill loader"
    },
    {
      "source": "dotfiles/.claude/skills/wp-abilities-api",
      "target": ".claude/skills/wp-abilities-api",
      "description": "WordPress Abilities API skill for Claude"
    },
    {
      "source": "dotfiles/.claude/skills/wp-abilities-api",
      "target": ".agents/skills/wp-abilities-api",
      "description": "WordPress Abilities API skill for Codex/agent skill loader"
    },
    {
      "source": "dotfiles/.claude/skills/wp-block-development",
      "target": ".claude/skills/wp-block-development",
      "description": "WordPress block development skill for Claude"
    },
    {
      "source": "dotfiles/.claude/skills/wp-block-development",
      "target": ".agents/skills/wp-block-development",
