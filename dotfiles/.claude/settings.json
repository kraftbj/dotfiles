{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/save-summary"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/commit-validator.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/code/dotfiles/dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context-a8c@automattic-claude-code-plugins": true,
    "triage@automattic-claude-code-plugins": true,
    "agents-md-support@kraftbj-claude-plugins": true,
    "ralph-loop@claude-plugins-official": true,
    "github-enterprise@automattic-claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}
