{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/save-summary"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/commit-validator.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/notify-waiting.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/code/dotfiles/dotfiles/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context-a8c@automattic-claude-code-plugins": true,
    "triage@automattic-claude-code-plugins": true
  }}
