{
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "a8c-design@automattic-claude-code-plugins": true,
    "a8c-extras@automattic-claude-code-plugins": true,
    "a8c-url-shorthand@automattic-claude-code-plugins": false,
    "agentic-actions-auditor@trailofbits": true,
    "agents-md-support@kraftbj-claude-plugins": true,
    "build-with-wordpress@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "coding-tutor@compound-engineering-plugin": false,
    "commit-commands@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true,
    "context-a8c@automattic-claude-code-plugins": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "git-cleanup@trailofbits": true,
    "github-enterprise@automattic-claude-code-plugins": true,
    "hookify@claude-plugins-official": true,
    "jetpack-boost@jetpack-boost-plugins": true,
    "linear-issue-solver@automattic-claude-code-plugins": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "presentations@automattic-claude-code-plugins": true,
    "product-manager-skills@automattic-claude-code-plugins": true,
    "ralph-loop@claude-plugins-official": true,
    "sdd@automattic-claude-code-plugins": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "systems-review@automattic-claude-code-plugins": true,
    "the-atelier@the-atelier": true,
    "triage@automattic-claude-code-plugins": true,
    "unit-tests@automattic-claude-code-plugins": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "repo": "jarrodwatts/claude-hud",
        "source": "github"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    },
    "jetpack-boost-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.a8c.com:Automattic/jetpack-boost-claude-plugins.git"
      }
    },
    "kraftbj-claude-plugins": {
      "source": {
        "repo": "kraftbj/claude-plugins",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "the-atelier": {
      "autoUpdate": true,
      "source": {
        "source": "git",
        "url": "git@github.a8c.com:Automattic/the-atelier.git"
      }
    },
    "trailofbits": {
      "source": {
        "repo": "trailofbits/skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/commit-validator.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/comment-style-validator.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/save-summary",
            "timeout": 120,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/code/dotfiles/dotfiles/.claude/hooks/session-context.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bash -c 'f=$HOME/.clawdboard/last-sync; [ -f \"$f\" ] && [ -n \"$(find \"$f\" -mmin -120 2>/dev/null)\" ] && exit 0; if command -v clawdboard >/dev/null 2>&1; then clawdboard hook-sync; else npx -y clawdboard hook-sync; fi'",
            "timeout": 120,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/kraft/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context-a8c_context-a8c",
      "Read(/Users/kraft/.claude/style-guide.md)",
      "Read(/Users/kraft/code/dotfiles/dotfiles/.claude/style-guide.md)"
    ]
  },
  "statusLine": {
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"$HOME/.bun/bin/bun\" --env-file /dev/null \"${plugin_dir}src/index.ts\"'",
    "type": "command"
  },
  "teammateMode": "auto",
  "tui": "fullscreen",
  "verbose": true
}
